{
  "name": "engageo-server-v2",
  "version": "2.0.0",
  "description": "Engageo AI Receptionist — Multilingual voice appointment booking over Exotel + Meta WhatsApp Cloud API",
  "main": "index.js",
  "scripts": {
    "prestart": "node db/migrate.js",
    "start": "node index.js",
    "dev": "nodemon --ignore '.env' index.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed-sai-shradha.js",
    "db:seed:skin-essence": "node db/seed-skin-essence.js",
    "test": "node tools/run-tests.js",
    "db:seed:sample": "node db/seed-sample-patients.js",
    "test:serial": "node tools/run-tests.js --serial",
    "test:db": "node tools/run-tests.js",
    "wa:route": "node tools/webhookRoute.js",
    "wa:templates": "node tools/metaTemplates.js",
    "wa:add-number": "node tools/addWhatsAppNumber.js",
    "calls:latency": "node tools/callLatency.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "exotel",
    "meta-whatsapp",
    "voicebot",
    "ai-receptionist",
    "sarvam",
    "groq"
  ],
  "author": "Siddharth Pathania",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "axios": "^1.13.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^10.6.1",
    "googleapis": "^171.4.0",
    "node-cron": "^4.2.1",
    "openai": "^4.104.0",
    "pg": "^8.20.0",
    "sarvamai": "^1.1.4",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "nodemon": "^3.1.14",
    "pg-mem": "^3.0.14"
  }
}
