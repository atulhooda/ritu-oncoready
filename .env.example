# Copy to .env. Never put real patient data anywhere in this project.

# Host ports for docker compose (change if something else on your machine uses them)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_EXPIRE_MINUTES=60

# LLM: extraction only (backend/app/llm/client.py). Gemini primary, Groq fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ritu voice (browser sessions). Leave unset to use the typed simulator.
# With the compose "voice" profile: RITU_BASE_URL=http://ritu:8090, PUBLIC_API_URL=http://backend:8000
RITU_BASE_URL=
RITU_SHARED_SECRET=
PUBLIC_API_URL=http://localhost:8000
