# ═══════════════════════════════════════════════════════════════════════════
# Engageo Server v2 — Environment Variables
# Telephony: Exotel (voice) | Messaging: Meta WhatsApp Cloud API
# ═══════════════════════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000

# ─── Exotel (Voice) ────────────────────────────────────────────────────────
# Exotel App Builder routes incoming calls via a Voicebot Applet that opens
# a WebSocket to this server at /media-stream?sample-rate=8000.
EXOTEL_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_PHONE_NUMBER=
EXOTEL_APP_ID=1225597

# ─── Meta WhatsApp Cloud API ───────────────────────────────────────────────
# Create an app at developers.facebook.com, add the WhatsApp product, and
# copy the Phone Number ID, permanent access token, and business account ID.
# The verify token is a string you choose — it must match what you configure
# in Meta's webhook verification UI.
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_BUSINESS_ACCOUNT_ID=
META_API_VERSION=v18.0
META_TEMPLATE_LANGUAGE=hi

# Template names (must match templates approved in Meta Business Manager)
META_TEMPLATE_CONFIRM=appointment_confirmation
META_TEMPLATE_REMIND=appointment_reminder
META_TEMPLATE_FOLLOWUP=appointment_followup
META_TEMPLATE_NOSHOW=no_show_recovery
META_TEMPLATE_MISSEDCALL=missed_call_recovery

# ─── Sarvam AI (STT + TTS) ─────────────────────────────────────────────────
SARVAM_API_KEY=
# SPEAKER is the default voice for any language NOT listed in SPEAKER_BY_LANG.
SPEAKER=ritu
PACE=1.05
SAMPLE_RATE=22050
# Per-CALL TTS voice. The voice is locked for the whole call (no mid-call
# switching): SPEAKER above (Suhani) handles Hindi/Hinglish; if Marathi appears
# anywhere in the call, it switches to the Marathi voice (Ritu) and stays there.
# This map sets which voice each special language uses. Unset → in-code default
# (mr-IN:ritu). Format 'langCode:speaker,...':
# SPEAKER_BY_LANG=mr-IN:ritu

# ─── LLM Providers ─────────────────────────────────────────────────────────
# Multiple OpenAI-compatible providers running Llama 3.3 70B / Llama 4 Scout
# (same Meta weights, different inference stacks). The primary handles every
# call; the fallback chain is walked in order on timeout, 5xx, network
# failure, or post-retry 429. Set at least one API key.
#
# Supported values:
#   - sambanova:  4K context, 10-30 RPM free tier. https://cloud.sambanova.ai
#   - groq:       llama-3.3-70b-versatile, 128K context, 100K TPD free tier.
#   - groq-scout: meta-llama/llama-4-scout-17b-16e-instruct, 131K context,
#                 500K TPD free tier (5x more). Groq labels as preview.
#                 Uses the same GROQ_API_KEY as 'groq'.
#   - deepinfra:  unlimited paid quota, ~$0.35/M tokens for Turbo (FP8).
#                 https://deepinfra.com
#
# Architecture lock (default):
#   primary    = groq-scout   (5x daily budget, fastest, prompt-compliant
#                              with the optimized system prompt)
#   fallback 1 = groq         (proven stable when Scout is rate-limited)
#   fallback 2 = gemini       (uncapped, India-payable INR — takes over when
#                              Groq's free daily TPD is spent; 3.1-flash-lite)
LLM_PRIMARY_PROVIDER=groq-scout
LLM_FALLBACK_PROVIDERS=groq,gemini
# Legacy alias (kept for backward compat — overridden by LLM_FALLBACK_PROVIDERS):
# LLM_FALLBACK_PROVIDER=groq
LLM_TIMEOUT_MS=8000
# First-token deadline on the streaming path: if a provider emits no first chunk
# within this window, fail over immediately instead of waiting out LLM_TIMEOUT_MS.
# Only the first chunk is timed, so long replies are never cut off. 0 disables.
# LLM_FIRST_CHUNK_TIMEOUT_MS=2500
# Circuit breaker: after a provider returns 429 (rate/daily-token limit), skip it
# for a cooldown so calls route straight to the next provider instead of eating a
# 429 every time. Re-probes + recovers automatically. ON by default.
# ENABLE_LLM_CIRCUIT_BREAKER=false      # set to disable
# LLM_BREAKER_COOLDOWN_MS=300000        # default 5 min (honors Retry-After if sent)
# Health probe: while a provider's circuit is open, re-check it OFF the call path
# so no patient call ever eats the discovery 429 (the failover switch stays ~0ms).
# ON by default. Probes only capped providers; no-op when nothing is capped.
# ENABLE_LLM_HEALTH_PROBE=false         # set to disable
# LLM_PROBE_INTERVAL_MS=60000           # default 60s

SAMBANOVA_API_KEY=
GROQ_API_KEY=
DEEPINFRA_API_KEY=
# Optional override — defaults to FP8 Turbo. Use meta-llama/Llama-3.3-70B-Instruct for FP16.
DEEPINFRA_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# Optional override for the groq-scout provider's model identifier.
GROQ_SCOUT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Feature flag — LLM→TTS streaming refactor. Default OFF. Flip to true only
# after the harness validation suite in BEHAVIOR_SPEC.md passes.
ENABLE_LLM_STREAMING=false

# ─── Google (Calendar + Sheets) ────────────────────────────────────────────
# Paste the full service account JSON as a single-line string.
GOOGLE_SERVICE_ACCOUNT_JSON=
CALENDAR_ID=

# ─── Postgres ──────────────────────────────────────────────────────────────
DATABASE_URL=

# ─── Optional: n8n webhook for error / event forwarding ────────────────────
N8N_WEBHOOK_URL=
