#!/bin/sh
# ─── PRE-PUSH GATE ───────────────────────────────────────────────────────────
# A push to main is a production deploy (hospital + demo). It must pass the gate.
#
# COMMITTED, AND REPO-RELATIVE — that is the whole point of this file. Its
# predecessor lived only in .git/hooks/pre-push, so no clone ever received it,
# and hardcoded /Users/siddharthpathania/… so it could not run anywhere else.
# Every quality claim in this repo rested on one uncommitted file on one laptop.
#
# Activate with:   git config core.hooksPath .githooks
# (tools/install-hooks.sh does this, and CONTRIBUTING notes it for a fresh clone.)
#
# The steps themselves live in tools/gate.sh, shared with .github/workflows,
# so the hook and CI can never drift into checking different things.
#
# Emergency bypass:  SUITE_BYPASS=1 git push …
# It is loud, and it is recorded — see below.
set -u

REPO="$(git rev-parse --show-toplevel)"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      if [ "${SUITE_BYPASS:-}" = "1" ]; then
        # ─── AN ESCAPE HATCH YOU CAN AUDIT ──────────────────────────────────
        # Kept, because a genuine outage should not be blocked by a gate. But a
        # bypass nobody can count is indistinguishable from no gate at all, so
        # this records WHO, WHEN and WHICH COMMIT, in the repo being deployed —
        # not in a sibling repo that a fresh clone would not have.
        echo "[GATE] ⚠⚠ SUITE BYPASSED (SUITE_BYPASS=1) — deploying UNGATED to production ⚠⚠"
        echo "[GATE] ⚠⚠ This is recorded in .gate-bypass.log. Open a follow-up before the next deploy. ⚠⚠"
        printf '%s  %s  %s  %s\n' \
          "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
          "$(git config user.email 2>/dev/null || echo unknown)" \
          "$(git rev-parse --short HEAD)" \
          "$(git log -1 --format=%s | cut -c1-72)" \
          >> "$REPO/.gate-bypass.log"
        continue
      fi
      sh "$REPO/tools/gate.sh" || exit 1
      ;;
  esac
done
exit 0
